{
  "python.defaultInterpreterPath": "d:\\sistema_relatorio_mensal_atividades\\.venv\\Scripts\\python.exe",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/venv/**",
    "**/_extracted_text/**",
    "**/relatorios_entregues/**",
    "**/__pycache__/**"
  ],
  "python.analysis.typeCheckingMode": "off",

  "flake8.interpreter": [
    "d:\\sistema_relatorio_mensal_atividades\\.venv\\Scripts\\python.exe"
  ],
  "flake8.importStrategy": "fromEnvironment",
  "flake8.args": [
    "--max-line-length=120",
    "--extend-ignore=E501,E402,W503,E203"
  ],

  "pylint.interpreter": [
    "d:\\sistema_relatorio_mensal_atividades\\.venv\\Scripts\\python.exe"
  ],
  "pylint.importStrategy": "fromEnvironment",
  "pylint.args": [
    "--rcfile=d:\\sistema_relatorio_mensal_atividades\\pyproject.toml"
  ],

  "djlint.enableLinting": true,
  "djlint.useNewLinter": true,
  "djlint.pythonPath": "d:\\sistema_relatorio_mensal_atividades\\.venv\\Scripts\\python.exe",
  "djlint.ignore": [
    "**/*.py",
    "**/*.js",
    "**/*.css",
    "**/.github/**/*.md",
    "**/.cursor/**/*.md",
    "**/.cursor/*.md",
    "**/tmp/**/*.html"
  ],

  "vscode-edge-devtools.webhint": false,

  "files.associations": {
    "**/tmp/**/*.html": "plaintext",
    "**/.github/**/*.md": "markdown",
    "**/templates/**/*.html": "jinja-html",
    "**/templates/**/*.htm": "jinja-html",
    "**/templates/**/*.j2": "jinja-html",
    "**/templates/**/*.jinja": "jinja-html",
    "**/templates/**/*.jinja2": "jinja-html"
  },

  "emmet.includeLanguages": {
    "jinja-html": "html"
  },

  "[jinja-html]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "monosans.djlint"
  },

  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [120]
  },

  "workbench.statusBar.visible": true,
  "zenMode.hideStatusBar": false,

  "tasks.statusbar.groups.sortAlphabetically": true,
  "tasks.statusbar.select.label": "$(chevron-down) Mais tarefas",
  "tasks.statusbar.select.color": "",
  "livePreview.defaultPreviewPath": "/app/templates/entregas_painel.html",

  "terminal.integrated.profiles.windows": {
    "SRA PowerShell 7": {
      "path": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe",
      "args": ["-NoProfile"],
      "icon": "terminal-powershell"
    },
    "SRA Windows PowerShell 5.1": {
      "path": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile"],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "SRA PowerShell 7",
  "terminal.integrated.automationProfile.windows": {
    "path": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass"]
  },
  "terminal.integrated.env.windows": {
    "PATH": "${env:ProgramFiles}\\PowerShell\\7;${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0;${env:PATH}"
  },

  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": false,
  "code-runner.executorMap": {
    "powershell": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File",
    "pwsh": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe -NoProfile -ExecutionPolicy Bypass -File"
  }
}
