# =====================================================================
# .env.example  -  copie para `.env` (NAO versionado) e preencha valores
# =====================================================================

# Conexao com o Postgres da app (formato aceito por SQLAlchemy + psycopg2)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/sra

# Chave para assinar sessao (itsdangerous). Use string longa e aleatoria.
SECRET_KEY=change-me-in-production-please

# Conta admin criada/atualizada pelo bootstrap na 1a execucao
ADMIN_EMAIL=admin@concremat.local
ADMIN_PASSWORD=change-me

APP_NAME=SRA - Sistema de Relatórios de Atividades
APP_ENV=development
# Rotas /dev/* (preview de modais e e-mail): em producao use 0; com APP_ENV!=development
# defina 1 para habilitar mesmo assim.
# SRA_MODAL_PREVIEW=1

# ---------------------------------------------------------------------
# Notificacoes mensais (SendGrid + cron)
# ---------------------------------------------------------------------
# Sem SENDGRID_API_KEY o sistema opera em modo SANDBOX: renderiza o email,
# valida o payload e registra como sucesso (mas NAO envia). Util em dev.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@concremat.local
SENDGRID_FROM_NAME=SRA · PLI-SP

# URL publica usada nos links dentro dos emails. Em dev: 127.0.0.1:8001.
APP_BASE_URL=http://127.0.0.1:8001

# Kill switch global. False = nada e enviado nem registrado em
# notificacao_envio (use em janelas de manutencao).
NOTIFICAR_HABILITADO=true

# Forcar SANDBOX mesmo com SENDGRID_API_KEY presente. True em staging.
NOTIFICAR_SANDBOX=false

# Token compartilhado dos endpoints /admin/cron/* (header X-Cron-Token).
# Em prod use string >=32 chars aleatoria. Token vazio = endpoints rejeitam tudo.
CRON_TOKEN=

# Opcional: painel /governanca-relatorio consulta status real do cron-job.org.
# Guarde a chave só no ambiente; se vazia, a página mostra status indisponível.
CRONJOB_ORG_API_KEY=
CRONJOB_ORG_JOB_ABRIR_PERIODO=7547405
CRONJOB_ORG_JOB_LEMBRETE_D5=7547406
CRONJOB_ORG_JOB_LEMBRETE_D8=7547407
CRONJOB_ORG_JOB_ULTIMA_CHAMADA=7547408
CRONJOB_ORG_JOB_RETRY_FALHAS=7547409

# ---------------------------------------------------------------------
# Variaveis OPCIONAIS usadas por scripts e tasks de manutencao
# ---------------------------------------------------------------------

# Token do Render (rnd_...). Usado pela task "SRA: status do ultimo deploy
# Render". Se nao estiver definido, a task pede no prompt.
# RENDER_API_TOKEN=
