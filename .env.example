# =====================================================================
# .env.example  -  copie para `.env` (NAO versionado) e preencha valores
# =====================================================================

# Conexao com o Postgres da app (formato aceito por SQLAlchemy + psycopg2)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/sra

# Chave para assinar sessao (itsdangerous). Use string longa e aleatoria.
SECRET_KEY=change-me-in-production-please

# Conta admin criada/atualizada pelo bootstrap na 1a execucao
ADMIN_EMAIL=admin@concremat.local
ADMIN_PASSWORD=change-me

APP_NAME=SRA - Sistema de Relatórios de Atividades
APP_ENV=development

# ---------------------------------------------------------------------
# Variaveis OPCIONAIS usadas por scripts e tasks de manutencao
# ---------------------------------------------------------------------

# Token do Render (rnd_...). Usado pela task "SRA: status do ultimo deploy
# Render". Se nao estiver definido, a task pede no prompt.
# RENDER_API_TOKEN=
