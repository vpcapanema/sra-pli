{
  "name": "sra-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Apenas dependencias de tooling (cspell e dicionarios). O projeto principal e Python.",
  "scripts": {
    "spell": "cspell --no-progress \"app/**/*.{py,html,css,js}\" \"*.md\" \".github/**/*.md\" \".cursor/**/*.{md,mdc}\"",
    "mdlint": "markdownlint-cli2 \".cursor/**/*.mdc\"",
    "dump-diags": "node scripts/npm-dump-diags.mjs"
  },
  "devDependencies": {
    "@cspell/dict-pt-br": "^1.0.0",
    "baseline-browser-mapping": "^2.10.27",
    "cspell": "^9.2.0",
    "hint": "^7.1.13",
    "markdownlint-cli2": "^0.22.0"
  }
}
